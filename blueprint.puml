@startuml

left to right direction

' CSC 3100 UML Style
skinparam shadowing false
skinparam roundCorner 0
skinparam classAttributeIconSize 0
skinparam linetype polyline
skinparam ArrowColor #555555
skinparam ArrowThickness 1

skinparam class {
    BorderColor #555555
    FontColor #222222
    FontSize 13
    AttributeFontSize 12
    StereotypeFontSize 11
}

hide circle

' Application classes: Yellow

class Handler #FFF2B3 {
    - BROKER_URL : String
    - TOPICS : String[]
    --
    + {static} main(args : String[]) : void
}

class Publisher #FFF2B3 {
    - broker : String
    - topics : String[]
    --
    + Publisher(brokerUrl : String, topics : String[])
    + run() : void
}

class Subscriber #FFF2B3 {
    - broker : String
    - topics : String[]
    --
    + Subscriber(brokerUrl : String, topics : String[])
    + run() : void
    + connectionLost(cause : Throwable) : void
    + messageArrived(topic : String, message : MqttMessage) : void
    + deliveryComplete(token : IMqttDeliveryToken) : void
}

' Library interfaces and classes: Blue

interface Runnable #DCEEFF {
    + run() : void
}

interface MqttCallback #DCEEFF {
    + connectionLost(cause : Throwable) : void
    + messageArrived(topic : String, message : MqttMessage) : void
    + deliveryComplete(token : IMqttDeliveryToken) : void
}

class MqttClient #DCEEFF {
    + connect() : void
    + setCallback(callback : MqttCallback) : void
    + subscribe(topic : String, qos : int) : void
    + publish(topic : String, message : MqttMessage) : void
    + disconnect() : void
}

' Associations: Solid lines with open arrowheads

Handler --> Publisher
Handler --> Subscriber

Publisher --> MqttClient
Subscriber --> MqttClient

' Realizations: Dashed lines with hollow triangles

Publisher ..|> Runnable
Subscriber ..|> Runnable
Subscriber ..|> MqttCallback

@enduml
